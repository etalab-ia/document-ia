# Copy this file to .env.qa (ignored by git) and fill in API keys per environment.
# Environment variables already exported in your shell take precedence over .env.qa.

# --- Local (http://localhost:8000) ---
QA_LOCAL_API_KEY=
QA_LOCAL_ADMIN_API_KEY=
# QA_LOCAL_BASE_URL=http://localhost:8000

# --- Sandbox (https://api.sandbox.document-ia.beta.gouv.fr) ---
QA_SANDBOX_API_KEY=
QA_SANDBOX_ADMIN_API_KEY=
# QA_SANDBOX_BASE_URL=https://api.sandbox.document-ia.beta.gouv.fr

# --- Staging / develop (https://api.staging.document-ia.beta.gouv.fr) ---
QA_STAGING_API_KEY=
QA_STAGING_ADMIN_API_KEY=
# QA_STAGING_BASE_URL=https://api.staging.document-ia.beta.gouv.fr

# --- Prod (https://api.document-ia.beta.gouv.fr) - requires --allow-prod ---
QA_PROD_API_KEY=
QA_PROD_ADMIN_API_KEY=
# QA_PROD_BASE_URL=https://api.document-ia.beta.gouv.fr

# --- Optional overrides ---
# Directory containing real documents and local scenarios (default: qa/data)
# QA_FIXTURES_DIR=qa/data

# Optional HTTPS webhook URL used by opt-in webhook tests
# QA_WEBHOOK_URL=https://example.com/qa-webhook
