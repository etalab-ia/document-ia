# Git & CI metadata
.git
.github
.gitignore
.gitleaks*
.pre-commit-config.yaml

# Local virtualenvs & caches
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.mypy_cache
**/.mypy_cache

# Local model cache (downloaded/verified hermetically during image build)
document-ia-worker/.models

# Environment & secrets
.env
**/.env
**/.env.*
!**/.env.example
**/secrets.toml
document-ia-evals/.streamlit/*
!document-ia-evals/.streamlit/config.toml

# Local runtime data, logs & caches
**/logs
**/*.log
document-ia-evals/data/*
!document-ia-evals/data/.gitkeep
document-ia-evals/src/document_ia_evals/static/review-pdfs
document-ia-worker/weights
.idea
.vscode
.DS_Store

# Documentation & tests (not needed in runtime images)
docs
**/tests
*.md
!**/README.md

# Nix build symlinks
result
result-*
